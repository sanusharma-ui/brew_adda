# Copy to .env.local. Never commit .env.local or real credentials.
# MongoDB Atlas (URL-encode special characters in username/password):
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
# For a local MongoDB installation, replace the URI above with:
# MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=lumea_coffee

# Replace with your own unique password, at least 12 characters.
ADMIN_PASSWORD=
# Example format only: a-long-unique-owner-password (do not use this literal value)

# Set a random secret, at least 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
